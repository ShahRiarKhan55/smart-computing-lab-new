DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-this-to-a-long-random-string"
PORT=4001
NODE_ENV=development

# Phase 26 — client-IP trust policy (see src/lib/trustProxy.ts for the full rationale). REQUIRED
# in production; development/test default to 0 (no reverse proxy) if left unset.
#   TRUST_PROXY=0  no reverse proxy in front of this server; X-Forwarded-For is never trusted.
#   TRUST_PROXY=1  exactly one trusted reverse-proxy hop that strips any client-supplied
#                  X-Forwarded-For before setting its own — the one topology this app's tests
#                  and docs certify (see docs/architecture/phase26-…).
# TRUST_PROXY=0

# Phase 26 — enables GET /sitemap.xml (served at the document root, not under /api — see
# src/routes/sitemap.routes.ts). Must be the public origin the SPA is actually served from
# (protocol + host, no trailing slash). GET /robots.txt works either way; it only omits its
# "Sitemap:" line when this is unset. Left unset by default rather than a fabricated domain.
# PUBLIC_BASE_URL="https://labs.example.edu"

# Phase 13 — file/media storage. STORAGE_DIR is where uploaded blobs live (metadata only in
# SQLite); it must stay outside apps/web/dist and is never served by express.static. Defaults to
# apps/server/storage/files if unset. MAX_IMAGE_BYTES / MAX_DOCUMENT_BYTES override the default
# per-category size limits (5 MB / 15 MB) documented in packages/shared/src/schemas/files.ts.
# STORAGE_DIR="./storage/files"
# MAX_IMAGE_BYTES=5242880
# MAX_DOCUMENT_BYTES=15728640
